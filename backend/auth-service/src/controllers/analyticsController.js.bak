    let query = `
      SELECT fo.*
      FROM fact_occupation_summary fo
      WHERE fo.snapshot_date = CURRENT_DATE
    `;

    const params = [];
    let paramCount = 1;

    if (templeId) {
      query += ` AND fo.temple_id = $${paramCount}`;
      params.push(templeId);
      paramCount++;
